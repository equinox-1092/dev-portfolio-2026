---
import "../styles/global.css";
import { getDictionary, localePath, locales, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#0e0a0d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/icon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localePath(l), Astro.site ?? Astro.url)} />
      ))
    }
    <link rel="preload" as="image" href="/hero/ezgif-frame-001.webp" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chivo:wght@400;700;900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="min-h-svh overflow-x-clip bg-bg text-ink antialiased">
    <slot />
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>

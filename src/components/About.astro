---
import { getDictionary, type Locale } from "../i18n";
import { site } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
// Odd segments were wrapped in ** and are set in full ink.
const parts = t.about.body.split("**");
---

<section id="about" class="px-gutter py-section">
  <div class="grid gap-x-10 gap-y-10 lg:grid-cols-12 lg:gap-y-0">
    <h2 class="display text-head lg:col-span-6 lg:col-start-7" data-settle>{t.about.heading}</h2>

    <figure class="portrait lg:col-span-5 lg:col-start-1 lg:row-span-2 lg:row-start-1" data-reveal>
      <div class="portrait-frame">
        <img
          src={site.portrait.src}
          width={site.portrait.width}
          height={site.portrait.height}
          alt={t.about.portraitAlt}
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>

    <div class="lg:col-span-6 lg:col-start-7 lg:mt-8" data-reveal>
      <p class="about-lead" data-settle>{t.about.lead}</p>

      <p class="about-body mt-6" data-settle>
        {parts.map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}
      </p>

      <dl class="facts mt-12" data-settle>
        {
          t.about.facts.map((fact) => (
            <div class="fact">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-12 flex flex-wrap gap-3" data-settle>
        <a href="#contact" class="btn">{t.about.cta}</a>
        <a href={site.cv} download class="btn btn-ghost">{t.hero.cv}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .portrait {
    align-self: start;
  }
  @media (min-width: 64rem) {
    .portrait {
      position: sticky;
      top: 6rem;
    }
  }
  .portrait-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }
  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 35%;
  }
  @media (max-width: 63.99rem) {
    .portrait-frame {
      aspect-ratio: 4 / 3;
    }
  }

  /* The portrait opens upward like a blind, the picture settling inside it. */
  :global(.js) .portrait[data-reveal] > .portrait-frame {
    opacity: 1;
    transform: none;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1100ms var(--ease-in-out);
  }
  :global(.js) .portrait[data-reveal] img {
    transform: scale(1.12);
    transition: transform 1400ms var(--ease-out);
  }
  :global(.js) .portrait[data-reveal].is-in > .portrait-frame {
    clip-path: inset(0);
  }
  :global(.js) .portrait[data-reveal].is-in img {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .portrait[data-reveal] > .portrait-frame {
      clip-path: none;
      opacity: 0;
      transition: opacity 300ms ease;
    }
    :global(.js) .portrait[data-reveal].is-in > .portrait-frame {
      opacity: 1;
    }
    :global(.js) .portrait[data-reveal] img {
      transform: none;
    }
  }

  /* Three voices: the lead says it, the body explains it, the facts let a scanner check it. */
  .about-lead {
    max-width: 24ch;
    font-size: clamp(1.5rem, 1.05rem + 1.6vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .about-body {
    max-width: 58ch;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .about-body strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  .facts {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .fact {
    padding: 1rem 1.125rem 1.125rem;
    background: var(--color-surface);
  }
  .fact dt {
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  .fact dd {
    margin-top: 0.25rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
</style>

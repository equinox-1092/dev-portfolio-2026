---

---

<header
  id="main-navbar"
  class="fixed top-8 sm:top-10 md:top-12 left-0 right-0 z-50 flex justify-center px-4 sm:px-8 opacity-0 -translate-y-8 pointer-events-none transition-all duration-700 ease-out"
>
  <div
    class="w-full max-w-6xl rounded-full bg-[#07070a]/85 backdrop-blur-2xl border border-white/15 shadow-[0_15px_45px_rgba(0,0,0,0.85)] px-5 sm:px-8 h-14 sm:h-16 flex items-center justify-between gap-4"
  >
    <a
      href="#hero"
      class="flex items-center gap-2 text-sm sm:text-base font-extrabold tracking-widest text-white hover:text-[#ec4899] transition shrink-0"
    >
      <span
        class="text-[#ec4899] font-mono text-lg sm:text-xl drop-shadow-[0_0_12px_rgba(236,72,153,0.6)]"
        >&lt;/&gt;</span
      >
      <span class="hidden md:inline">MATIAS DIAZ</span>
      <span class="md:hidden font-bold">MATIAS</span>
    </a>
    <nav
      class="flex items-center gap-3 sm:gap-5 md:gap-8 overflow-x-auto no-scrollbar py-1"
    >
      <a
        href="#hero"
        class="nav-item text-xs sm:text-sm md:text-base font-semibold text-gray-300 hover:text-white transition relative py-1 shrink-0 active-section"
        data-nav="hero"
      >
        <span class="lang-en">Home</span>
        <span class="lang-es hidden">Inicio</span>
      </a>
      <a
        href="#about"
        class="nav-item text-xs sm:text-sm md:text-base font-semibold text-gray-300 hover:text-white transition relative py-1 shrink-0"
        data-nav="about"
      >
        <span class="lang-en">About</span>
        <span class="lang-es hidden">Sobre Mí</span>
      </a>
      <a
        href="#skills"
        class="nav-item text-xs sm:text-sm md:text-base font-semibold text-gray-300 hover:text-white transition relative py-1 shrink-0"
        data-nav="skills"
      >
        <span class="lang-en">Skills</span>
        <span class="lang-es hidden">Habilidades</span>
      </a>
      <a
        href="#projects"
        class="nav-item text-xs sm:text-sm md:text-base font-semibold text-gray-300 hover:text-white transition relative py-1 shrink-0"
        data-nav="projects"
      >
        <span class="lang-en">Projects</span>
        <span class="lang-es hidden">Proyectos</span>
      </a>
      <a
        href="#certificates"
        class="nav-item text-xs sm:text-sm md:text-base font-semibold text-gray-300 hover:text-white transition relative py-1 shrink-0"
        data-nav="certificates"
      >
        <span class="lang-en">Certificates</span>
        <span class="lang-es hidden">Certificados</span>
      </a>
      <a
        href="#contact"
        class="nav-item text-xs sm:text-sm md:text-base font-semibold text-gray-300 hover:text-white transition relative py-1 shrink-0"
        data-nav="contact"
      >
        <span class="lang-en">Contact</span>
        <span class="lang-es hidden">Contacto</span>
      </a>
    </nav>
    <div
      class="flex items-center gap-1 text-xs sm:text-sm font-extrabold shrink-0"
    >
      <button
        id="btn-lang-en"
        class="px-1.5 py-0.5 text-[#ec4899] underline underline-offset-4 decoration-2 transition"
        >EN</button
      >
      <span class="text-gray-600">|</span>
      <button
        id="btn-lang-es"
        class="px-1.5 py-0.5 text-gray-400 hover:text-white transition">ES</button
      >
    </div>
  </div>
</header>

<style>
  /* Floating Navbar revealed state */
  .navbar-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
    pointer-events: auto !important;
  }

  /* Minimalist Active Section Underline Indicator */
  .nav-item.active-section {
    color: #ffffff !important;
  }

  .nav-item.active-section::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2.5px;
    background: linear-gradient(90deg, #ec4899, #8b5cf6);
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(236, 72, 153, 0.7);
  }

  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  // Language Switcher Logic
  const btnEn = document.getElementById("btn-lang-en");
  const btnEs = document.getElementById("btn-lang-es");

  function setLanguage(lang: "en" | "es") {
    if (lang === "en") {
      btnEn?.classList.add(
        "text-[#ec4899]",
        "underline",
        "underline-offset-4",
        "decoration-2",
      );
      btnEn?.classList.remove("text-gray-400");
      btnEs?.classList.remove(
        "text-[#ec4899]",
        "underline",
        "underline-offset-4",
        "decoration-2",
      );
      btnEs?.classList.add("text-gray-400");
      document
        .querySelectorAll(".lang-en")
        .forEach((el) => el.classList.remove("hidden"));
      document
        .querySelectorAll(".lang-es")
        .forEach((el) => el.classList.add("hidden"));
    } else {
      btnEs?.classList.add(
        "text-[#ec4899]",
        "underline",
        "underline-offset-4",
        "decoration-2",
      );
      btnEs?.classList.remove("text-gray-400");
      btnEn?.classList.remove(
        "text-[#ec4899]",
        "underline",
        "underline-offset-4",
        "decoration-2",
      );
      btnEn?.classList.add("text-gray-400");
      document
        .querySelectorAll(".lang-es")
        .forEach((el) => el.classList.remove("hidden"));
      document
        .querySelectorAll(".lang-en")
        .forEach((el) => el.classList.add("hidden"));
    }
  }

  btnEn?.addEventListener("click", () => setLanguage("en"));
  btnEs?.addEventListener("click", () => setLanguage("es"));

  // ScrollSpy IntersectionObserver for active section highlighting
  const navItems = document.querySelectorAll(".nav-item");
  const sectionIds = [
    "hero",
    "about",
    "skills",
    "projects",
    "certificates",
    "contact",
  ];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter(Boolean) as HTMLElement[];

  function updateActiveNav(activeId: string) {
    navItems.forEach((item) => {
      const navTarget = item.getAttribute("data-nav");
      if (navTarget === activeId) {
        item.classList.add("active-section");
      } else {
        item.classList.remove("active-section");
      }
    });
  }

  const observerOptions = {
    root: null,
    rootMargin: "-20% 0px -40% 0px",
    threshold: 0.15,
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        updateActiveNav(entry.target.id);
      }
    });
  }, observerOptions);

  sections.forEach((section) => observer.observe(section));
</script>

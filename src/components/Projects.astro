---
import { getDictionary, type Locale } from "../i18n";
import { projects } from "../data/projects";
import CurriculumMap from "./CurriculumMap.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<!-- The one inverted field on the page: the work sits on bone, like a printed sheet. -->
<section id="work" class="work bg-ink px-gutter py-section text-bg">
  <div class="mb-12 flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3 sm:mb-16" data-settle>
    <h2 class="display text-head">{t.work.heading}</h2>
    <p class="max-w-[40ch] text-bg/75">{t.work.note}</p>
  </div>

  <div class="flex flex-col gap-section">
    {
      projects.map((project) => {
        const copy = t.work.projects[project.id];
        return (
          <article class="grid gap-x-10 gap-y-10 lg:grid-cols-12" data-reveal>
            <h3 class="project-name display lg:col-span-12" data-settle>{project.name}</h3>

            <div class="lg:col-span-5" data-settle>
              <p class="text-lead font-bold leading-snug">{copy.tagline}</p>
              <p class="mt-4 max-w-[60ch]">{copy.summary}</p>

              <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-2 xl:grid-cols-3">
                <div>
                  <dt class="text-small text-bg/70">{t.work.year}</dt>
                  <dd class="font-bold">{project.year}</dd>
                </div>
                <div>
                  <dt class="text-small text-bg/70">{t.work.role}</dt>
                  <dd class="font-bold">{copy.role}</dd>
                </div>
                <div class="col-span-2 sm:col-span-1 lg:col-span-2 xl:col-span-1">
                  <dt class="text-small text-bg/70">{t.work.builtWith}</dt>
                  <dd class="font-bold">{project.tech.join(" · ")}</dd>
                </div>
              </dl>

              {project.repo && (
                <a href={project.repo} target="_blank" rel="noopener noreferrer" class="btn mt-10">
                  {t.work.repo}
                </a>
              )}
            </div>

            {project.curriculum && project.curriculum.length > 0 && (
              <div class="lg:col-span-7">
                <CurriculumMap project={project} cycleLabel={t.work.cycle} copy={copy} />
              </div>
            )}
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .project-name {
    font-size: var(--text-poster);
    overflow-wrap: anywhere;
  }
  .work ::selection {
    background: var(--color-bg);
    color: var(--color-ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .work :global(.btn:hover) {
      background: var(--color-bg);
      color: var(--color-ink);
    }
  }
</style>

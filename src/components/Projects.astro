const projects = [
	{
		title: "EduGraph",
		category: "FEATURED PROJECT",
		descriptionEn: "The application was developed with Next.js and Tailwind and provides the presentation layer for university career planning. It is structured following principles inspired by Clean Architecture, maintaining a clear separation between presentation logic, application logic, and domain utilities. As for the backend, FastAPI was chosen as a standalone service, which communicates with the frontend via HTTP requests and uses MySQL as the database engine for data persistence.",
		descriptionEs: "La aplicación fue desarrollada con Next.js y Tailwind y proporciona la capa de presentación para la planificación de carreras universitarias. Está estructurada siguiendo principios inspirados en Clean Architecture, manteniendo una clara separación entre la lógica de presentación, la lógica de aplicación y las utilidades de dominio. En cuanto al backend, se eligió FastAPI como servicio independiente, el cual se comunica con el frontend mediante solicitudes HTTP y utiliza MySQL como motor de base de datos para la persistencia de datos.",
		year: "2025",
		roleEn: "Frontend Developer",
		roleEs: "Desarrollador Frontend",
		docLink: "https://github.com/edugraph-ods",
		techIcons: ["VSCode", "FastAPI", "MySQL", "Next.js", "Tailwind", "Figma", "GitHub"]
	}
];
---

<section id="projects" class="py-32 px-6 relative z-10">
	<div class="max-w-6xl mx-auto">
		<div class="mb-14">
			<span class="text-xs font-mono tracking-widest text-[#f472b6] uppercase block mb-2">// FEATURED PROJECTS</span>
			<h2 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight">
				<span class="lang-en">Projects</span>
				<span class="lang-es hidden">Proyectos</span>
			</h2>
		</div>

		<div class="space-y-12">
			{projects.map((project) => (
				<article class="p-8 md:p-12 rounded-3xl border border-white/10 bg-[#121216]/80 backdrop-blur-xl shadow-2xl grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
					
					<!-- Left: Visual Mockup & Tech Icons -->
					<div class="lg:col-span-6 space-y-6">
						<div class="rounded-2xl overflow-hidden border border-slate-700/50 bg-white text-slate-900 shadow-xl">
							<div class="bg-slate-100 px-4 py-3 border-b border-slate-200 flex items-center justify-between">
								<div class="flex items-center gap-2">
									<span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
									<span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
									<span class="w-3 h-3 rounded-full bg-purple-500 inline-block"></span>
								</div>
								<span class="text-xs font-semibold text-slate-500">EduGraph - Career Flow</span>
							</div>

							<div class="p-6 bg-slate-50 space-y-6">
								<div class="flex items-center gap-2 flex-wrap">
									<div class="px-3 py-2 bg-white rounded-lg border border-slate-300 text-xs font-bold text-slate-800 shadow-sm">Matemática Básica</div>
									<span class="text-slate-400 font-bold">→</span>
									<div class="px-3 py-2 bg-white rounded-lg border border-slate-300 text-xs font-bold text-slate-800 shadow-sm">Cálculo 1</div>
									<span class="text-slate-400 font-bold">→</span>
									<div class="px-3 py-2 bg-white rounded-lg border border-slate-300 text-xs font-bold text-slate-800 shadow-sm">Física 1</div>
									<span class="text-slate-400 font-bold">→</span>
									<div class="px-3 py-2 bg-white rounded-lg border border-slate-300 text-xs font-bold text-slate-800 shadow-sm">Algoritmos</div>
								</div>

								<div class="flex items-center gap-3">
									<span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-xs font-bold">✓ Aprobado</span>
									<span class="px-3 py-1 bg-pink-100 text-pink-800 rounded-full text-xs font-bold">⏳ En Curso</span>
								</div>
							</div>
						</div>

						<!-- Tech Circle Badges with Real SVG Icons -->
						<div class="flex items-center justify-center gap-3 flex-wrap">
							{project.techIcons.map((tech) => (
								<div class="group/icon relative w-11 h-11 rounded-full bg-white/5 border border-white/15 flex items-center justify-center shadow-md transition duration-300 hover:bg-white/10 hover:border-[#ec4899]/40 hover:shadow-[#ec4899]/20 hover:shadow-lg hover:-translate-y-1">
									<div class="w-6 h-6 flex items-center justify-center" set:html={techIconMap[tech] || ''} />
									<span class="absolute -bottom-7 left-1/2 -translate-x-1/2 text-[10px] font-bold text-gray-400 opacity-0 group-hover/icon:opacity-100 transition whitespace-nowrap pointer-events-none">{tech}</span>
								</div>
							))}
						</div>
					</div>

					<!-- Right: Description & Meta Information -->
					<div class="lg:col-span-6 space-y-6">
						<h3 class="text-3xl md:text-4xl font-extrabold text-white">{project.title}</h3>

						<p class="text-gray-300 text-base leading-relaxed font-light lang-en">
							{project.descriptionEn}
						</p>
						<p class="text-gray-300 text-base leading-relaxed font-light lang-es hidden">
							{project.descriptionEs}
						</p>

						<div class="pt-4 border-t border-white/10 space-y-3">
							<h4 class="text-xs font-mono tracking-widest text-white uppercase font-bold">PROJECT INFORMATION</h4>
							
							<div class="flex justify-between text-sm">
								<span class="text-gray-400">
									<span class="lang-en">Year</span>
									<span class="lang-es hidden">Año</span>
								</span>
								<span class="font-bold text-white">{project.year}</span>
							</div>

							<div class="flex justify-between text-sm">
								<span class="text-gray-400">
									<span class="lang-en">Role</span>
									<span class="lang-es hidden">Rol</span>
								</span>
								<span class="font-bold text-white">
									<span class="lang-en">{project.roleEn}</span>
									<span class="lang-es hidden">{project.roleEs}</span>
								</span>
							</div>
						</div>

						<!-- Action Button -->
						<div class="pt-2">
							<a href={project.docLink} class="inline-flex items-center gap-3 px-6 py-3 rounded-full border border-[#ec4899] text-white font-semibold text-sm transition duration-300 hover:bg-[#ec4899]/20 hover:shadow-lg hover:shadow-[#ec4899]/30 hover:-translate-y-1">
								<span class="w-2.5 h-2.5 rounded-full bg-[#ec4899] shadow-[0_0_10px_#ec4899]"></span>
								<span class="lang-en">View Documentation</span>
								<span class="lang-es hidden">Ver Documentación</span>
							</a>
						</div>
					</div>

				</article>
			))}
		</div>
	</div>
</section>

<style>
	.hidden {
		display: none !important;
	}
</style>

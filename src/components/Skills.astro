---

<section id="skills" class="py-32 px-6 relative z-10">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <h2
        class="text-4xl md:text-5xl font-extrabold text-white mb-3 tracking-tight"
      >
        <span class="lang-en">Skills</span>
        <span class="lang-es hidden">Habilidades</span>
      </h2>
      <p class="text-gray-400 text-lg">
        <span class="lang-en">Experience with technologies and tools</span>
        <span class="lang-es hidden"
          >Experiencia con tecnologías y herramientas</span
        >
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
      {
        skills.map((skill) => (
          <div class="group relative p-6 rounded-2xl border border-white/10 bg-[#121216]/80 backdrop-blur-xl flex flex-col items-center justify-center gap-4 transition duration-300 hover:-translate-y-2 hover:border-[#ec4899]/50 hover:shadow-xl hover:shadow-[#ec4899]/20">
            <div
              class="w-12 h-12 flex items-center justify-center transition transform group-hover:scale-110 duration-300"
              set:html={skill.icon}
            />
            <span class="text-white font-bold text-base tracking-wide text-center">
              {skill.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hidden {
    display: none !important;
  }
</style>

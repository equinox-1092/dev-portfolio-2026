---
import { getDictionary, type Locale } from "../i18n";
import { site } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const f = t.contact.form;
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || "";

const rows = [
  { href: site.linkedin, label: t.contact.links.linkedin, detail: "linkedin.com/in/matias-diaz", external: true },
  { href: site.github, label: t.contact.links.github, detail: "github.com/equinox-1092", external: true },
  { href: site.cv, label: t.contact.links.cv, detail: "PDF", download: true },
];
---

<section id="contact" class="py-section">
  <h2 class="display mb-10 px-gutter text-head sm:mb-14" data-settle>{t.contact.heading}</h2>

  <ul data-reveal>
    {
      rows.map((row) => (
        <li class="odd:bg-surface">
          <a
            href={row.href}
            class="contact-row px-gutter"
            data-settle
            {...(row.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            {...(row.download ? { download: "" } : {})}
          >
            <span class="display contact-label">{row.label}</span>
            <span class="text-small font-bold text-muted">{row.detail}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-section grid gap-10 px-gutter lg:grid-cols-12" data-reveal>
    <p class="text-lead font-bold leading-snug lg:col-span-5" data-settle>{t.contact.intro}</p>

    <form
      id="contact-form"
      class="flex flex-col gap-5 lg:col-span-6 lg:col-start-7"
      data-success={f.success}
      data-error={f.error}
      data-network={f.network}
      data-not-configured={f.notConfigured}
      data-sending={f.sending}
    >
      <input type="hidden" name="access_key" value={web3FormsKey} />
      <input type="hidden" name="subject" value={f.subject} />
      <input type="hidden" name="from_name" value="Portfolio" />
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

      <label class="field">
        <span>{f.name}</span>
        <input type="text" name="name" required autocomplete="name" placeholder={f.namePlaceholder} />
      </label>
      <label class="field">
        <span>{f.email}</span>
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          autocapitalize="none"
          spellcheck="false"
          placeholder={f.emailPlaceholder}
        />
      </label>
      <label class="field">
        <span>{f.message}</span>
        <textarea name="message" rows="5" required placeholder={f.messagePlaceholder}></textarea>
      </label>

      <p role="status" class="status empty:hidden" data-status></p>

      <button type="submit" class="btn self-start" data-submit>
        <span data-submit-label>{f.send}</span>
      </button>
    </form>
  </div>
</section>

<style>
  .contact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 2rem;
    padding-block: clamp(1.25rem, 3vw, 2.25rem);
  }
  .contact-label {
    font-size: var(--text-head);
    transition: color 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .contact-row:hover .contact-label {
      color: var(--color-accent);
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-weight: 700;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.875rem 1rem;
    font-weight: 400;
    background: var(--color-surface);
    color: var(--color-ink);
    border: 2px solid transparent;
    transition: border-color 200ms ease;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-muted);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--color-accent);
  }
  .field textarea {
    resize: vertical;
  }

  .status {
    padding: 1rem;
    font-weight: 700;
    background: var(--color-surface);
  }
  .status[data-type="success"] {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .status[data-type="error"] {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
  [data-submit]:disabled {
    opacity: 0.6;
    cursor: progress;
  }
</style>

<script>
  import "../scripts/contact";
</script>

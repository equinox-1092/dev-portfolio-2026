---
const web3FormsKey =
  import.meta.env.PUBLIC_WEB3FORMS_KEY || "YOUR_WEB3FORMS_ACCESS_KEY_HERE";
---

<section id="contact" class="py-32 px-6 relative z-10">
  <div class="max-w-6xl mx-auto">
    <div
      class="p-8 md:p-14 rounded-3xl border border-white/10 bg-[#121216]/80 backdrop-blur-xl shadow-2xl grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16"
    >
      <!-- Left Information -->
      <div class="lg:col-span-6 space-y-6">
        <span
          class="text-xs font-mono tracking-widest text-[#f472b6] uppercase block"
          >// GET IN TOUCH</span
        >
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-tight"
        >
          <span class="lang-en">Let's Work Together</span>
          <span class="lang-es hidden">Trabajemos Juntos</span>
        </h2>
        <p
          class="text-gray-300 text-base md:text-lg font-light leading-relaxed"
        >
          <span class="lang-en"
            >Available for freelance opportunities, full-time engineering roles,
            or creative technical collaborations. Feel free to reach out!</span
          >
          <span class="lang-es hidden"
            >Disponible para proyectos freelance, roles a tiempo completo o
            colaboraciones creativas. ¡No dudes en contactarme!</span
          >
        </p>
        <div class="pt-4 space-y-4">
          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-xl text-[#ec4899]"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 640 640"
                class="w-6 h-6 fill-current"
              >
                <path
                  d="M320 48C337.7 48 352 62.3 352 80L352 98.3C450.1 112.3 527.7 189.9 541.7 288L560 288C577.7 288 592 302.3 592 320C592 337.7 577.7 352 560 352L541.7 450.1 450.1 527.7 352 541.7L352 560C352 577.7 337.7 592 320 592C302.3 592 288 577.7 288 560L288 541.7C189.9 527.7 112.3 450.1 98.3 352L80 352C62.3 352 48 337.7 48 320C48 302.3 62.3 288 80 288L98.3 288C112.3 189.9 189.9 112.3 288 98.3L288 80C288 62.3 302.3 48 320 48zM160 320C160 408.4 231.6 480 320 480C408.4 480 480 408.4 480 320C480 231.6 408.4 160 320 160C231.6 160 160 231.6 160 320zM320 224C373 224 416 267 416 320C416 373 373 416 320 416C267 416 224 373 224 320C224 267 267 224 320 224z"
                ></path>
              </svg>
            </div>
            <div>
              <span class="text-xs text-gray-400 block">
                <span class="lang-en">Location</span>
                <span class="lang-es hidden">Ubicación</span>
              </span>
              <span class="text-base font-semibold text-white">
                <span class="lang-en">Remote / Worldwide</span>
                <span class="lang-es hidden">Remoto / Todo el mundo</span>
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-6">
        <form id="contact-form" class="space-y-4">
          <input type="hidden" name="access_key" value={web3FormsKey} />
          <input
            type="hidden"
            name="subject"
            value="Nuevo mensaje de contacto desde tu Portafolio"
          />
          <input
            type="hidden"
            name="from_name"
            value="Portafolio Contact Form"
          />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display: none;"
          />
          <div>
            <label
              for="contact-name"
              class="block text-xs font-bold text-gray-300 mb-2 uppercase tracking-wider"
            >
              <span class="lang-en">Name</span>
              <span class="lang-es hidden">Nombre</span>
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="Your Name"
              class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-[#ec4899] transition"
            />
          </div>
          <div>
            <label
              for="contact-email"
              class="block text-xs font-bold text-gray-300 mb-2 uppercase tracking-wider"
            >
              <span class="lang-en">Email</span>
              <span class="lang-es hidden">Correo Electrónico</span>
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="your@email.com"
              class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-[#ec4899] transition"
            />
          </div>
          <div>
            <label
              for="contact-msg"
              class="block text-xs font-bold text-gray-300 mb-2 uppercase tracking-wider"
            >
              <span class="lang-en">Message</span>
              <span class="lang-es hidden">Mensaje</span>
            </label>
            <textarea
              id="contact-msg"
              name="message"
              rows="4"
              required
              placeholder="Tell me about your project..."
              class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-[#ec4899] transition"
            ></textarea>
          </div>
          <div
            id="contact-status"
            class="hidden p-4 rounded-xl text-sm font-medium transition-all"
          >
          </div>
          <button
            type="submit"
            id="contact-submit-btn"
            class="w-full py-4 rounded-xl bg-gradient-to-r from-[#ec4899] to-[#8b5cf6] text-white font-extrabold text-base transition duration-300 hover:shadow-lg hover:shadow-[#ec4899]/30 hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >
            <span id="btn-text" class="flex items-center gap-2">
              <span class="lang-en">Send Message</span>
              <span class="lang-es hidden">Enviar Mensaje</span>
            </span>
            <span id="btn-spinner" class="hidden">
              <svg
                class="animate-spin h-5 w-5 text-white inline"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                ></path>
              </svg>
            </span>
          </button>
        </form>
      </div>
    </div>
    <footer
      class="pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-gray-400"
    >
      <div class="font-bold text-white tracking-wide">
        Matias Diaz <span class="text-[#ec4899]">.</span>
      </div>
      <p>© 2026 Matias Diaz - All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a
          href="https://github.com/equinox-1092"
          target="_blank"
          class="hover:text-[#ec4899] transition">GitHub</a
        >
        <a
          href="https://linkedin.com/in/matias-diaz-7aa06831b"
          target="_blank"
          class="hover:text-[#ec4899] transition">LinkedIn</a
        >
      </div>
    </footer>
  </div>
</section>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const statusDiv = document.getElementById("contact-status");
  const submitBtn = document.getElementById(
    "contact-submit-btn",
  ) as HTMLButtonElement | null;
  const btnText = document.getElementById("btn-text");
  const btnSpinner = document.getElementById("btn-spinner");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!statusDiv || !submitBtn || !btnSpinner) return;

      // Clear previous status
      statusDiv.classList.add("hidden");
      statusDiv.className =
        "hidden p-4 rounded-xl text-sm font-medium transition-all";

      // Show loading spinner
      submitBtn.disabled = true;
      btnSpinner.classList.remove("hidden");

      const formData = new FormData(form);
      const accessKey = formData.get("access_key")?.toString();

      if (!accessKey || accessKey === "YOUR_WEB3FORMS_ACCESS_KEY_HERE") {
        showStatus("error", {
          en: "⚠️ Access Key not configured yet. Please set your key in the .env file.",
          es: "⚠️ Clave de Access Key no configurada aún. Por favor agrega tu clave de Web3Forms en el archivo .env.",
        });
        resetBtn();
        return;
      }

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const result = await response.json();

        if (response.status === 200 && result.success) {
          showStatus("success", {
            en: "✨ Message sent successfully! I will reply to your email soon.",
            es: "✨ ¡Mensaje enviado con éxito! Te responderé a tu correo muy pronto.",
          });
          form.reset();
        } else {
          showStatus("error", {
            en: result.message || "Error sending message. Please try again.",
            es:
              result.message ||
              "Ocurrió un error al enviar el mensaje. Intenta nuevamente.",
          });
        }
      } catch (error) {
        showStatus("error", {
          en: "Network error. Please check your connection and try again.",
          es: "Error de red. Verifica tu conexión e intenta nuevamente.",
        });
      } finally {
        resetBtn();
      }
    });
  }

  function resetBtn() {
    if (submitBtn && btnSpinner) {
      submitBtn.disabled = false;
      btnSpinner.classList.add("hidden");
    }
  }

  function showStatus(
    type: "success" | "error",
    messages: { en: string; es: string },
  ) {
    if (!statusDiv) return;
    statusDiv.classList.remove("hidden");

    if (type === "success") {
      statusDiv.classList.add(
        "bg-emerald-500/10",
        "border",
        "border-emerald-500/30",
        "text-emerald-300",
      );
    } else {
      statusDiv.classList.add(
        "bg-rose-500/10",
        "border",
        "border-rose-500/30",
        "text-rose-300",
      );
    }

    statusDiv.innerHTML = `
      <span class="lang-en">${messages.en}</span>
      <span class="lang-es hidden">${messages.es}</span>
    `;

    // Check if Spanish is currently active in the page navbar
    const btnEsActive = document
      .getElementById("btn-lang-es")
      ?.classList.contains("text-[#ec4899]");
    if (btnEsActive) {
      statusDiv.querySelector(".lang-en")?.classList.add("hidden");
      statusDiv.querySelector(".lang-es")?.classList.remove("hidden");
    }
  }
</script>

<style>
  .hidden {
    display: none !important;
  }
</style>

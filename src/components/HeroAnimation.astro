---

<div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
  <canvas
    id="hero-canvas"
    class="w-full h-full object-cover filter contrast-105 saturate-105"
  ></canvas>
  <div
    class="absolute inset-0 bg-gradient-to-b from-[#07070a]/60 via-[#07070a]/35 to-[#07070a]/75 pointer-events-none"
  >
  </div>
</div>
<div
  id="hero-preloader"
  class="fixed inset-0 z-50 bg-[#07070a] flex items-center justify-center transition-all duration-500"
>
  <div class="flex flex-col items-center gap-6 text-center">
    <div class="w-14 h-14 relative">
      <div
        class="w-full h-full border-4 border-pink-500/20 border-t-[#ec4899] border-r-[#8b5cf6] rounded-full animate-spin"
      >
      </div>
    </div>
    <div class="flex flex-col items-center gap-2">
      <span class="text-xs font-mono uppercase tracking-widest text-gray-400"
        >Loading Experience</span
      >
      <div class="w-56 h-1.5 bg-white/10 rounded-full overflow-hidden">
        <div
          id="preloader-bar"
          class="h-full w-0 bg-gradient-to-r from-[#ec4899] to-[#8b5cf6] rounded-full transition-all duration-150 shadow-[0_0_10px_rgba(236,72,153,0.5)]"
        >
        </div>
      </div>
      <span
        id="preloader-percent"
        class="font-mono text-lg font-bold text-[#ec4899]">0%</span
      >
    </div>
  </div>
</div>
<section
  id="hero"
  class="relative z-10 min-h-screen flex items-center pt-28 pb-16"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-2xl space-y-6">
      <p
        class="text-lg md:text-xl text-gray-200 font-normal drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)]"
      >
        <span class="lang-en">Hello everyone, welcome to my portfolio.</span>
        <span class="lang-es hidden"
          >Hola a todos, bienvenidos a mi portafolio.</span
        >
      </p>
      <h1
        class="text-5xl sm:text-6xl md:text-7xl font-black text-white leading-tight tracking-tight drop-shadow-[0_4px_30px_rgba(0,0,0,0.95)]"
      >
        <span class="lang-en">I am Matias Diaz</span>
        <span class="lang-es hidden">Soy Matias Diaz</span>
      </h1>
      <p
        class="text-xl md:text-2xl font-medium text-gray-300 drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)]"
      >
        <span class="lang-en">Software Engineer</span>
        <span class="lang-es hidden">Ingeniero de Software</span>
      </p>
      <div class="pt-4 flex items-center gap-5">
        <a
          href="/cv/Matías Sebastian Diaz Quispe - currículum vítae.pdf"
          target="_blank"
          download
          class="inline-flex items-center gap-3 px-6 py-3 rounded-full border border-[#ec4899] bg-[#07070a]/40 backdrop-blur-md text-white font-semibold text-base transition duration-300 hover:bg-[#ec4899]/20 hover:shadow-lg hover:shadow-[#ec4899]/30 hover:-translate-y-1"
        >
          <span
            class="w-2.5 h-2.5 rounded-full bg-[#ec4899] shadow-[0_0_10px_#ec4899]"
          ></span>
          <span class="lang-en">Download CV</span>
          <span class="lang-es hidden">Descargar CV</span>
        </a>
        <a
          href="https://github.com/equinox-1092"
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-[#ec4899] transition duration-300 hover:bg-[#ec4899]/20 hover:border-[#ec4899] hover:text-white hover:-translate-y-1"
          aria-label="GitHub"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
        </a>
        <a
          href="https://linkedin.com/in/matias-diaz-7aa06831b"
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-[#ec4899] transition duration-300 hover:bg-[#ec4899]/20 hover:border-[#ec4899] hover:text-white hover:-translate-y-1"
          aria-label="LinkedIn"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hidden {
    display: none !important;
  }
</style>

<script>
  const TOTAL_FRAMES = 240;
  const FRAME_PATH_PREFIX = "/hero/ezgif-frame-";
  const FRAME_PATH_SUFFIX = ".png";

  const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement;
  const ctx = canvas ? canvas.getContext("2d") : null;
  const preloader = document.getElementById("hero-preloader") as HTMLElement;
  const preloaderBar = document.getElementById("preloader-bar") as HTMLElement;
  const preloaderPercent = document.getElementById(
    "preloader-percent",
  ) as HTMLElement;

  const images: HTMLImageElement[] = [];
  let targetFrame = 0;
  let currentFrame = 0;
  let isLoaded = false;

  function getFrameUrl(index: number): string {
    const paddedNum = String(index + 1).padStart(3, "0");
    return `${FRAME_PATH_PREFIX}${paddedNum}${FRAME_PATH_SUFFIX}`;
  }

  function resizeCanvas() {
    if (!canvas || !ctx) return;
    const dpr = Math.max(window.devicePixelRatio || 1, 2);
    canvas.width = window.innerWidth * dpr;
    canvas.height = window.innerHeight * dpr;
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";

    if (isLoaded) {
      renderFrame(Math.round(currentFrame));
    }
  }

  function renderFrame(index: number) {
    if (!ctx || !canvas) return;
    const safeIndex = Math.max(0, Math.min(TOTAL_FRAMES - 1, index));
    const img = images[safeIndex];

    if (!img || !img.complete || img.naturalWidth === 0) return;

    const canvasWidth = canvas.width;
    const canvasHeight = canvas.height;
    const imgWidth = img.naturalWidth;
    const imgHeight = img.naturalHeight;

    const scale = Math.max(canvasWidth / imgWidth, canvasHeight / imgHeight);
    const drawWidth = imgWidth * scale;
    const drawHeight = imgHeight * scale;
    const offsetX = (canvasWidth - drawWidth) / 2;
    const offsetY = (canvasHeight - drawHeight) / 2;

    ctx.clearRect(0, 0, canvasWidth, canvasHeight);
    ctx.drawImage(img, offsetX, offsetY, drawWidth, drawHeight);
  }

  function lerpAnimationLoop() {
    const ease = 0.12;
    const delta = targetFrame - currentFrame;

    if (Math.abs(delta) > 0.001) {
      currentFrame += delta * ease;
      renderFrame(Math.round(currentFrame));
    } else if (Math.round(currentFrame) !== Math.round(targetFrame)) {
      currentFrame = targetFrame;
      renderFrame(Math.round(currentFrame));
    }

    requestAnimationFrame(lerpAnimationLoop);
  }

  function updateScroll() {
    const maxScroll =
      document.documentElement.scrollHeight - window.innerHeight;
    if (maxScroll <= 0) return;

    const scrollY = window.scrollY || window.pageYOffset || 0;
    const progress = Math.max(0, Math.min(1, scrollY / maxScroll));

    targetFrame = progress * (TOTAL_FRAMES - 1);
  }

  function preloadImages() {
    let loaded = 0;
    for (let i = 0; i < TOTAL_FRAMES; i++) {
      const img = new Image();
      img.src = getFrameUrl(i);

      const onSingleLoad = () => {
        loaded++;
        const pct = Math.floor((loaded / TOTAL_FRAMES) * 100);
        if (preloaderBar) preloaderBar.style.width = `${pct}%`;
        if (preloaderPercent) preloaderPercent.textContent = `${pct}%`;

        if (loaded === TOTAL_FRAMES) {
          onAllLoaded();
        }
      };

      img.onload = onSingleLoad;
      img.onerror = onSingleLoad;
      images.push(img);
    }
  }

  function onAllLoaded() {
    isLoaded = true;
    resizeCanvas();
    renderFrame(0);
    updateScroll();

    lerpAnimationLoop();

    if (preloader) {
      setTimeout(() => {
        preloader.classList.add("opacity-0", "pointer-events-none");
        document.getElementById("main-navbar")?.classList.add("navbar-visible");
      }, 300);
    }
  }

  window.addEventListener("resize", resizeCanvas);
  window.addEventListener("scroll", updateScroll, { passive: true });

  resizeCanvas();
  preloadImages();
</script>

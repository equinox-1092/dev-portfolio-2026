---
import { fmt, getDictionary, type Locale } from "../i18n";
import { certificates, formatCertificateDate } from "../data/certificates";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const total = certificates.length;
const items = certificates.map((cert, i) => ({
  ...cert,
  tag: t.certificates.tags[cert.id],
  meta: `${cert.issuer} · ${formatCertificateDate(cert.date, locale)}`,
  position: fmt(t.certificates.position, { n: i + 1, total }),
}));
const first = items[0];
---

<section id="certificates" class="overflow-clip bg-surface py-section">
  <div class="mb-10 flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3 px-gutter sm:mb-14" data-settle>
    <h2 class="display text-head">{t.certificates.heading}</h2>
    <p class="max-w-[42ch] text-muted">{t.certificates.intro}</p>
  </div>

  <!-- Certificates sit on the rim of a large wheel; turning it brings one to the top. -->
  <div class="wheel-stage" data-wheel-stage>
    <ul class="wheel" data-wheel>
      {
        items.map((cert, i) => (
          <li class="wheel-slot" style={`--i: ${i}`}>
            <button
              type="button"
              class="wheel-card"
              aria-label={`${cert.title}, ${cert.position}`}
              aria-current={i === 0 ? "true" : undefined}
              data-far={i > 2 ? "" : undefined}
              tabindex={i === 0 ? 0 : -1}
              data-title={cert.title}
              data-tag={cert.tag}
              data-meta={cert.meta}
              data-position={cert.position}
              data-image={cert.image}
              data-width={cert.width}
              data-height={cert.height}
            >
              <img
                src={cert.image}
                width={cert.width}
                height={cert.height}
                alt=""
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mx-auto mt-6 flex max-w-[44rem] flex-col items-center gap-6 px-gutter text-center">
    <div aria-live="polite" data-wheel-caption>
      <p class="text-small font-bold text-accent">
        <span data-field="tag">{first.tag}</span> · <span data-field="position">{first.position}</span>
      </p>
      <h3 class="cert-title mt-2 text-lead font-black leading-tight" data-field="title">{first.title}</h3>
      <p class="mt-1 text-muted" data-field="meta">{first.meta}</p>
    </div>
    <div class="flex justify-center gap-3">
      <button type="button" class="btn btn-ghost icon-btn" aria-label={t.certificates.prev} data-wheel-prev disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="btn" data-wheel-open>{t.certificates.open}</button>
      <button type="button" class="btn btn-ghost icon-btn" aria-label={t.certificates.next} data-wheel-next>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>

  <dialog class="cert-dialog" data-cert-dialog aria-label={first.title}>
    <form method="dialog" class="flex justify-end">
      <button class="btn btn-ghost">{t.certificates.close}</button>
    </form>
    <img src={first.image} width={first.width} height={first.height} alt={first.title} data-cert-dialog-img />
  </dialog>
</section>

<style>
  /* Geometry: card width, radius as a multiple of it (--k) and the angle between cards.
     scripts/certificates.ts reads --k and --step, so change them only here. */
  .wheel-stage {
    --w: min(78vw, 32rem);
    --h: calc(var(--w) * 0.775);
    --k: 2.6;
    --r: calc(var(--w) * var(--k));
    --step: 24deg;
    position: relative;
    height: calc(var(--h) + var(--w) * 0.24 + 1rem);
    touch-action: pan-y;
    cursor: grab;
  }
  .wheel-stage.is-dragging {
    cursor: grabbing;
  }

  .wheel {
    position: absolute;
    left: 50%;
    top: calc(var(--h) / 2 + var(--r));
    width: 0;
    height: 0;
    transition: transform 650ms var(--ease-out);
  }
  .is-dragging .wheel {
    transition: none;
  }

  .wheel-slot {
    position: absolute;
    left: calc(var(--w) / -2);
    top: calc(var(--h) / -2);
    width: var(--w);
    height: var(--h);
    transform: rotate(calc(var(--i) * var(--step))) translateY(calc(var(--r) * -1));
  }

  .wheel-card {
    display: block;
    width: 100%;
    height: 100%;
    background: #fff;
    opacity: 0.4;
    transform: scale(0.86);
    transition:
      transform 450ms var(--ease-out),
      opacity 450ms ease;
  }
  .wheel-card[aria-current="true"] {
    opacity: 1;
    transform: none;
  }
  .wheel-card[data-far] {
    opacity: 0;
    pointer-events: none;
  }
  .wheel-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .wheel-card:not([aria-current="true"]):not([data-far]):hover {
      opacity: 0.7;
    }
  }

  .cert-title {
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .icon-btn {
    width: 3rem;
    padding: 0;
  }
  .icon-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: square;
  }
  .icon-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .cert-dialog {
    margin: auto;
    max-width: min(96vw, 80rem);
    padding: 0;
    background: transparent;
    color: var(--color-ink);
    opacity: 1;
    transform: none;
    transition:
      opacity 220ms ease-out,
      transform 220ms var(--ease-out);
  }
  @starting-style {
    .cert-dialog[open] {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  .cert-dialog::backdrop {
    background: rgb(14 10 13 / 0.94);
  }
  .cert-dialog img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100svh - 7rem);
    margin-top: 0.75rem;
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel,
    .wheel-card,
    .cert-dialog {
      transition: opacity 200ms ease;
    }
  }
</style>

<script>
  import "../scripts/certificates";
</script>
